# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by the app and its tooling.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Local environment overrides.
.env
.env.*
!.env.example

# Editor and OS cruft.
.DS_Store
*.swp
